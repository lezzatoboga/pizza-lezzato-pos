# Env Edge Function untuk pengembangan LOKAL (npx supabase functions serve --env-file <salinan>).
# Salin ke berkas di LUAR repo (README paket: URL env lokal tidak di-commit), lalu isi
# kata sandi UJI LOKAL dari supabase/website-tiruan/02_peran_pos_lokal.sql.
# Database website tiruan = website_tiruan di stack lokal POS; dari dalam Docker hostnya `db`
# (nama kontainer bergaris bawah ditolak Deno). BUKAN kredensial produksi — kredensial
# produksi diisi Owner sebagai secret Supabase (tahap C).
WEBSITE_POS_READER_DB_URL=postgresql://pos_reader:<kata-sandi-uji-lokal>@db:5432/website_tiruan
WEBSITE_POS_STATUS_DB_URL=postgresql://pos_status_writer:<kata-sandi-uji-lokal>@db:5432/website_tiruan
WEBSITE_DB_SSL=disable
SYNC_MENU_CRON_SECRET=uji-lokal-cron
