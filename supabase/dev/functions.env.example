# Env Edge Function untuk pengembangan LOKAL (npx supabase functions serve --env-file ...).
# Nilai di bawah hanya kata sandi UJI LOKAL dari supabase/dev/website-stub.sql —
# BUKAN kredensial produksi. Kredensial produksi diisi Owner sebagai secret Supabase.
WEBSITE_POS_READER_DB_URL=postgresql://pos_reader:uji-lokal-reader@db:5432/postgres
WEBSITE_POS_STATUS_DB_URL=postgresql://pos_status_writer:uji-lokal-writer@db:5432/postgres
WEBSITE_DB_SSL=disable
SYNC_MENU_CRON_SECRET=uji-lokal-cron
